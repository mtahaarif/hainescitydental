# Example environment variables for HostGator MySQL + app secrets
# PRODUCTION DEPLOYMENT CHECKLIST:
# 1. Copy this template to .env.local for local development
# 2. Add these same variables to Vercel project settings (Settings > Environment Variables)
# 3. NEVER commit .env.local to Git
# 4. NEVER expose credentials in code - use env vars only

# HostGator MySQL (REQUIRED - Must be set before deployment)
HOSTGATOR_DB_HOST=192.185.22.109
HOSTGATOR_DB_USER=hainesci_user
HOSTGATOR_DB_PASSWORD=your_database_password_here
HOSTGATOR_DB_NAME=hainesci_dental_db
HOSTGATOR_DB_PORT=3306

# JWT Secret - MUST BE 32+ CHARACTERS (REQUIRED - Generate using: openssl rand -base64 32)
# Generate on Unix/Mac: openssl rand -base64 32
# Generate on Windows: [System.Convert]::ToBase64String([System.Text.Encoding]::UTF8.GetBytes((1..32 | ForEach-Object { [char](48..122 | Get-Random) }) -join ''))
JWT_SECRET=generate_a_random_32_plus_character_string_here_critical_for_production

# Admin CMS Login Credentials (REQUIRED - Must be strong password)
CMS_ADMIN_USERNAME=hainescitydental
CMS_ADMIN_PASSWORD=your_very_strong_admin_password_here

# Node Environment
NODE_ENV=production

# Next.js specific
NEXT_PUBLIC_APP_URL=https://your_domain.com

# Email Configuration (REQUIRED for contact forms)
# For Gmail: Use App Password (not regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=office@hainescitydental.com
