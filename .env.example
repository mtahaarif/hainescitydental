# Example environment variables for HostGator MySQL + app secrets
# Copy to .env.local (local) or add to Vercel project Environment Variables

# HostGator MySQL (required for new HostGator-backed endpoints)
HOSTGATOR_DB_HOST=your_hostgator_db_host.example.com
HOSTGATOR_DB_USER=your_db_user
HOSTGATOR_DB_PASSWORD=your_db_password
HOSTGATOR_DB_NAME=your_db_name
HOSTGATOR_DB_PORT=3306

# JWT secret - must be at least 32 chars
JWT_SECRET=super_long_secret_at_least_32_characters

# Admin credentials for CMS (used by /api/admin/login)
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=replace_this_with_a_strong_password
